# Copy to web/.env.local (git ignores it). On Vercel, set these as Environment Variables.
# Only the server function reads them; they never reach a browser.

# Execute-only Lit usage key for the website: "Can execute in groups" = proveit-google
# and proveit-discord ONLY. Not your account key, not the dev key.
LIT_USAGE_KEY=

# Upstash Redis REST credentials (console.upstash.com → your database → REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional limits on how many checks can run (each costs about 1 Lit credit).
# PROVEIT_MAX_CHECKS_PER_IP_10MIN=10
# PROVEIT_MAX_CHECKS_PER_DAY=300
