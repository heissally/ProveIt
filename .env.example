# Copy this file to .env.local (which git ignores) and fill in the values.
# Never commit .env.local, paste it into chat, or put these keys in frontend code.

# Lit Chipotle API (the hosted production API).
LIT_API_BASE=https://api.chipotle.litprotocol.com

# Your Lit ACCOUNT API key: the master key for your whole Lit account.
# Used only by scripts on your own machine.
LIT_ACCOUNT_API_KEY=

# Milestone 1 only: an execute-only usage key for the "proveit-m1-probes" group.
LIT_PROBE_USAGE_KEY=

# Development usage key: execute-only in the "proveit-google" and "proveit-discord"
# groups. Used by scripts on your machine. NEVER the key the website uses.
LIT_DEV_USAGE_KEY=
